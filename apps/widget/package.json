{
  "name": "@parity/browse-widget",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:paseo": "APP_DEBUG=true NETWORK_GENESIS_HASH=0x4349b00e54897e21196fd331015fc5be0f14e118beb0375ed2bb1793737bb57a vite --port 3001",
    "dev:previewnet": "APP_DEBUG=true NETWORK_GENESIS_HASH=0xbac97e23fc8f4bccae72a98f8aeb2bcab20bf755862304e4b46ad6473456e896 vite --port 3001",
    "dev:host": "bun run dev:host:previewnet",
    "dev:host:paseo": "APP_TRUAPI_BRIDGE_PORT=${APP_TRUAPI_BRIDGE_PORT:-9956} APP_DEBUG=true NETWORK_GENESIS_HASH=0x4349b00e54897e21196fd331015fc5be0f14e118beb0375ed2bb1793737bb57a truapi-host dev --network paseo-next-v2 --port ${APP_TRUAPI_BRIDGE_PORT:-9956} --app-port ${DEV_PORT:-3001} -- vite --port ${DEV_PORT:-3001} --strictPort",
    "dev:host:previewnet": "APP_TRUAPI_BRIDGE_PORT=${APP_TRUAPI_BRIDGE_PORT:-9956} APP_DEBUG=true NETWORK_GENESIS_HASH=0xbac97e23fc8f4bccae72a98f8aeb2bcab20bf755862304e4b46ad6473456e896 truapi-host dev --network previewnet --port ${APP_TRUAPI_BRIDGE_PORT:-9956} --app-port ${DEV_PORT:-3001} -- vite --port ${DEV_PORT:-3001} --strictPort",
    "build": "vite build --outDir ../../app/dist/widget --emptyOutDir",
    "preview": "vite preview --outDir ../../app/dist/widget",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/martian-mono": "^5.2.7",
    "@parity/browse-client": "*",
    "@parity/browse-sdk": "*",
    "@tanstack/react-query": "^5.96.2",
    "lucide-preact": "^1.8.0",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.25.0"
  }
}
