{
  "name": "@parity/browse-developer-portal",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:paseo": "NETWORK_GENESIS_HASH=0x4349b00e54897e21196fd331015fc5be0f14e118beb0375ed2bb1793737bb57a vite --port 3010",
    "dev:previewnet": "NETWORK_GENESIS_HASH=0xbac97e23fc8f4bccae72a98f8aeb2bcab20bf755862304e4b46ad6473456e896 vite --port 3010",
    "dev:host": "bun run dev:host:paseo",
    "dev:host:paseo": "APP_TRUAPI_BRIDGE_PORT=${APP_TRUAPI_BRIDGE_PORT:-9965} APP_DEBUG=true NETWORK_GENESIS_HASH=0x4349b00e54897e21196fd331015fc5be0f14e118beb0375ed2bb1793737bb57a truapi-host dev --network paseo-next-v2 --port ${APP_TRUAPI_BRIDGE_PORT:-9965} --app-port ${DEV_PORT:-4000} -- vite --port ${DEV_PORT:-4000} --strictPort",
    "dev:host:previewnet": "APP_TRUAPI_BRIDGE_PORT=${APP_TRUAPI_BRIDGE_PORT:-9965} APP_DEBUG=true NETWORK_GENESIS_HASH=0xbac97e23fc8f4bccae72a98f8aeb2bcab20bf755862304e4b46ad6473456e896 truapi-host dev --network previewnet --port ${APP_TRUAPI_BRIDGE_PORT:-9965} --app-port ${DEV_PORT:-4000} -- vite --port ${DEV_PORT:-4000} --strictPort",
    "build": "vite build --outDir dist --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "test:e2e": "APP_PGAS_FUNDING_TIMEOUT=1000 NETWORK_GENESIS_HASH=0x4349b00e54897e21196fd331015fc5be0f14e118beb0375ed2bb1793737bb57a playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@parity/browse-sdk": "*",
    "@parity/product-sdk": "^0.31.0",
    "polkadot-api": "^2.1.2",
    "preact": "^10.29.1",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "^1.8.0",
    "@parity/host-api-test-sdk": "^0.15.0",
    "@playwright/test": "^1.59.1",
    "@polkadot-labs/hdkd": "^0.0.27",
    "@polkadot-labs/hdkd-helpers": "^0.0.28",
    "@preact/preset-vite": "^2.10.5",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.25.0"
  }
}
