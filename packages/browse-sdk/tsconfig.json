{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": [
      "#/source"
    ],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../snapshots/src"
  ],
  "exclude": [
    "dist",
    "examples",
    "**/*.spec.ts",
    "**/*.test.ts",
    "../snapshots/src/**/*.spec.ts",
    "../snapshots/src/**/*.test.ts"
  ]
}
