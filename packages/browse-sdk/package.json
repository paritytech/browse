{
  "name": "@parity/browse-sdk",
  "version": "0.1.0",
  "description": "Client SDK for the publishing registry. Read published apps, widgets, and workers via any papi-compatible JsonRpcProvider.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/paritytech/browse.git",
    "directory": "packages/browse-sdk"
  },
  "homepage": "https://github.com/paritytech/browse/tree/main/packages/browse-sdk#readme",
  "bugs": {
    "url": "https://github.com/paritytech/browse/issues"
  },
  "main": "./dist/browse-sdk/src/index.js",
  "types": "./dist/browse-sdk/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "#/source": "./src/index.ts",
      "types": "./dist/browse-sdk/src/index.d.ts",
      "default": "./dist/browse-sdk/src/index.js"
    },
    "./snapshots": {
      "#/source": "./src/snapshots.ts",
      "types": "./dist/browse-sdk/src/snapshots.d.ts",
      "default": "./dist/browse-sdk/src/snapshots.js"
    },
    "./config": {
      "#/source": "./src/config.ts",
      "types": "./dist/browse-sdk/src/config.d.ts",
      "default": "./dist/browse-sdk/src/config.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ensdomains/content-hash": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@polkadot-api/json-rpc-provider": "^0.2.0",
    "polkadot-api": "^2.1.4",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@parity/product-sdk": "^0.22.0",
    "@polkadot-api/ws-provider": "^0.9.0",
    "@polkadot-labs/hdkd": "^0.0.27",
    "@polkadot-labs/hdkd-helpers": "^0.0.28",
    "@polkadot/api": "^16.5.4",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@parity/product-sdk": "^0.22.0",
    "@polkadot-labs/hdkd": "^0.0.27",
    "@polkadot-labs/hdkd-helpers": "^0.0.28",
    "@polkadot/api": "^16.5.4"
  },
  "peerDependenciesMeta": {
    "@parity/product-sdk": {
      "optional": true
    },
    "@polkadot-labs/hdkd": {
      "optional": true
    },
    "@polkadot-labs/hdkd-helpers": {
      "optional": true
    },
    "@polkadot/api": {
      "optional": true
    }
  }
}
